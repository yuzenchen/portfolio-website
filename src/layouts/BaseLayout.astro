---
import '@styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Yuzen Chen - IT SRE & Full Stack Developer',
  description = '專精於網站開發、系統可靠性工程與DevOps自動化',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Noto+Sans+TC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div id="particles-canvas"></div>
    <slot />

    <script>
      import '@scripts/main';
    </script>
  </body>
</html>
