---
const services = [
  {
    title: '流程自動化',
    desc: '把對帳、排程、資料轉換這類重複作業交給系統，員工的時間回到需要判斷的事情上。',
    chips: ['付款對帳', '排程與批次作業', '系統之間的資料串接'],
  },
  {
    title: '系統與網站開發',
    desc: '從形象官網到含金流、物流的完整電商系統，設計、開發、上線、維護都由我負責。',
    chips: ['客製開發', '手機版完整支援', 'LINE Pay 金流', '7-11 超商取貨'],
  },
  {
    title: '技術顧問',
    desc: '幫您檢查現有系統的架構和資安弱點，給一份可以直接執行的改善清單。',
    chips: ['系統健檢', '資安與效能診斷', '技術決策諮詢'],
  },
];
---
<section id="services">
  <div class="sec-head">
    <span class="sec-num">02</span>
    <h2>我能幫您做什麼</h2>
  </div>
  <ul class="svc-lanes">
    {services.map(({ title, desc, chips }) => (
      <li class="svc-lane">
        <h3 class="svc-title">{title}</h3>
        <p class="svc-desc">{desc}</p>
        <ul class="svc-stations">
          {chips.map((c) => <li><span>{c}</span></li>)}
        </ul>
      </li>
    ))}
  </ul>
</section>
