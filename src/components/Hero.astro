---
/**
 * The race: one reconciliation run at Wama' House, by hand and automated.
 * Each lane has five steps; the clocks are static (the measured 2 hours and
 * 20 minutes) and only the bars and step lists play. The server renders the
 * finished state, so without JS (or with reduced motion) the visitor sees
 * the result directly.
 */
const lanes = [
  {
    id: 'manual',
    name: '人工處理',
    minutes: 120,
    clock: { num: '2', unit: '小時' },
    steps: ['匯出明細', '逐筆比對', '找逾時付款', '手動更正', '完成'],
    // The steps that eat the two hours stay hatched in the finished still.
    slow: [1, 3],
  },
  {
    id: 'auto',
    name: '系統自動',
    minutes: 20,
    clock: { num: '20', unit: '分鐘' },
    steps: ['排程啟動', '掃描逾時付款', '向 LINE Pay 查詢', '自動更正', '完成'],
    slow: [] as number[],
  },
];
---
<header class="hero">
  <div class="hero-grid">
    <div class="hero-copy">
      <h1>
        <span class="hero-line">員工每天重複做的事，</span>
        <span class="hero-line hl">交給系統自動完成。</span>
      </h1>
      <p class="hero-desc">
        對帳、轉單、出貨、報表，這些每天都要做、又不能出錯的工作，我幫您變成自動執行的系統。
      </p>
      <div class="hero-actions">
        <a href="#contact" class="btn-primary" data-booking>免費諮詢 15 分鐘</a>
        <a href="#case" class="hero-link">看實際案例 →</a>
      </div>
    </div>

    <figure class="race" data-race aria-labelledby="race-title">
      <figcaption class="race-head">
        <span class="race-caption">
          <span id="race-title">每次對帳，兩種跑法<span class="sr-only">，</span><span class="race-source">Wama' House 實測</span></span>
          <span class="race-scale">縮時：1 秒約 20 分鐘</span>
        </span>
        {/* Always in the layout so showing it never moves the panel; inert
            (and invisible) until a run completes. */}
        <button type="button" class="race-replay" data-replay inert>重跑一次</button>
      </figcaption>

      {lanes.map(({ id, name, minutes, clock, steps, slow }) => (
        <div
          class:list={['lane', `lane--${id}`, 'is-finished']}
          data-lane
          data-minutes={minutes}
          role="group"
          aria-label={`${name}，每次對帳 ${clock.num} ${clock.unit}`}
        >
          <div class="lane-row">
            <span class="lane-name">{name}</span>
            <span class="lane-clock">
              <span class="lane-clock-num">{clock.num}</span>
              <span class="lane-clock-unit">{clock.unit}</span>
            </span>
          </div>
          <div class="lane-bar" aria-hidden="true">
            {steps.map((_, i) => (
              <span class:list={['seg', 'is-done', slow.includes(i) && 'is-slow']}></span>
            ))}
          </div>
          <ol class="lane-steps">
            {steps.map((s) => <li class="is-done">{s}</li>)}
          </ol>
        </div>
      ))}
    </figure>
  </div>
</header>
