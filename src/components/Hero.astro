---
const chips = ['Python', 'JavaScript', 'React', 'Docker', 'Kubernetes'];
---
<div class="hero">
  <canvas id="cvWave"></canvas>
  <div class="hero-inner">
    <div class="kicker">// IT SRE &amp; Full Stack Developer</div>
    <h1><span id="typeA"></span><br /><span id="typeB"></span><span id="cursor"></span></h1>
    <p>
      Yuzen Chen — 專精網站開發、系統可靠性工程與 DevOps 自動化，打造高效能、高可用性的技術解決方案。
    </p>
    <div class="hero-actions">
      <a href="#services" class="btn-primary">探索服務</a>
      <a href="#work" class="btn-secondary">查看作品</a>
    </div>
    <div class="chips">
      {chips.map((chip) => <span class="chip">{chip}</span>)}
    </div>
  </div>
</div>
