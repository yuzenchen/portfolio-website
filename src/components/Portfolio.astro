---
import { getCollection } from 'astro:content';

const items = (await getCollection('portfolio')).sort(
  (a, b) => a.data.order - b.data.order,
);
---
<section id="work">
  <div class="sec-head">
    <span class="sec-num">02</span>
    <h2>精選作品</h2>
  </div>
  <div class="work-grid">
    {items.map(({ data }) => {
      const body = (
        <>
          <div class="proj-thumb">
            {data.image && (
              <img src={data.image} alt={data.title} loading="lazy" decoding="async" />
            )}
            {data.category && <span class="proj-cat">{data.category}</span>}
          </div>
          <div class="proj-body">
            <h3>{data.title}</h3>
            <p>{data.description}</p>
            <div class="proj-tags">
              {data.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </div>
        </>
      );

      // A card with a live site is one big link; otherwise it's display-only.
      return data.demo ? (
        <a
          class="proj proj--link"
          href={data.demo}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${data.title}（另開新視窗）`}
        >
          {body}
        </a>
      ) : (
        <article class="proj">{body}</article>
      );
    })}
  </div>
</section>
