---
import { getCollection } from 'astro:content';

const items = (await getCollection('portfolio')).sort(
  (a, b) => a.data.order - b.data.order,
);
---
{items.length > 0 && (
  <div class="others">
    <h3 class="others-title">其他作品</h3>
    {items.map(({ data }) => (
      <article class="other">
        <div class="other-thumb">
          {data.image && (
            <img src={data.image} alt={data.title} loading="lazy" decoding="async" />
          )}
        </div>
        <div class="other-body">
          {data.category && <span class="other-cat">{data.category}</span>}
          <h4>{data.title}</h4>
          <p>{data.description}</p>
          <div class="proj-tags">
            {data.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </div>
      </article>
    ))}
  </div>
)}
