---
import { getCollection } from 'astro:content';

const items = (await getCollection('portfolio')).sort(
  (a, b) => a.data.order - b.data.order,
);
---
<section id="portfolio" class="portfolio">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">精選作品</h2>
      <div class="section-line"></div>
    </div>
    <div class="portfolio-grid">
      {items.map(({ data }) => {
        // Prefer Demo button; fall back to Repo (so non-public services still get one CTA)
        const cta = data.demo
          ? { href: data.demo, label: 'Demo', icon: '🌐' }
          : data.repo
            ? { href: data.repo, label: 'Repo', icon: '💻' }
            : null;

        return (
          <div class:list={["portfolio-item", data.image && "portfolio-item--has-image"]}>
            <div class="portfolio-image">
              <div class="project-placeholder">
                <div class="placeholder-icon">{data.icon}</div>
                <div class="placeholder-text" set:html={data.placeholderTitle}></div>
              </div>
              {data.image && (
                <img
                  src={data.image}
                  alt={data.title}
                  class="portfolio-screenshot"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div class="portfolio-overlay">
                <div class="portfolio-info">
                  <h3>{data.title}</h3>
                  <p>{data.description}</p>
                  <div class="portfolio-tags">
                    {data.tags.map((tag) => <span>{tag}</span>)}
                  </div>
                  {cta && (
                    <div class="portfolio-links">
                      <a
                        href={cta.href}
                        class="portfolio-link-btn"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${data.title} ${cta.label}`}
                      >
                        <span class="portfolio-link-icon">{cta.icon}</span>
                        <span>{cta.label}</span>
                      </a>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
