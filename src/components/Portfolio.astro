---
import { getCollection } from 'astro:content';

const items = (await getCollection('portfolio')).sort(
  (a, b) => a.data.order - b.data.order,
);
---
<section id="work" class="work fade">
  <div class="sec-mark">## work</div>
  <h2>精選作品</h2>
  <div class="grid3">
    {items.map(({ data }) => {
      // Prefer the live site; fall back to the repo for services that aren't public.
      const cta = data.demo
        ? { href: data.demo, label: '網址 →' }
        : data.repo
          ? { href: data.repo, label: 'Repo →' }
          : null;

      return (
        <article class="proj">
          <div class="thumb">
            {data.image ? (
              <img src={data.image} alt={data.title} loading="lazy" decoding="async" />
            ) : (
              '[ 專案截圖 ]'
            )}
          </div>
          <div class="proj-body">
            <h3>{data.title}</h3>
            <p>{data.description}</p>
            <div class="tags">
              {data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
            {cta && (
              <a href={cta.href} target="_blank" rel="noopener noreferrer">{cta.label}</a>
            )}
          </div>
        </article>
      );
    })}
  </div>
</section>
