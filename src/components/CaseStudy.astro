---
const highlights = [
  {
    title: '三種角色，一套系統',
    body: '訪客瀏覽下單、經銷商專屬組合包與批量訂貨、管理者後台（組合包／加價購管理、即時定價預覽、訂單列表、團購頁）。',
  },
  {
    title: '付款對帳自動化',
    body: '定時掃描逾時未完成的付款，主動向 LINE Pay 查詢並自動更正訂單狀態，不需人工對帳。',
  },
  {
    title: '7-11 超商取貨物流串接',
    body: '整合綠界科技 ECPay 物流 API，後台一鍵產出托運單，物流狀態自動回寫訂單。',
  },
];

const shots = [
  { src: '/case-dashboard.jpg', label: '營運 Dashboard' },
  { src: '/case-inventory.jpg', label: '庫存管理' },
  { src: '/case-orders.jpg', label: '訂單 / 物流' },
];
---
<section id="case">
  <div class="sec-head">
    <span class="sec-num">01</span>
    <h2>精選案例</h2>
    <span class="sec-note">/ 從零到上線</span>
  </div>

  <article class="case">
    <div class="case-shot">
      <div class="case-shot-main">
        <img src="/petsnack.png" alt="Wama' House 寵物零食電商" loading="lazy" decoding="async" />
      </div>

      <!-- Backend screenshots live under the storefront shot and reveal with
           the points on the right, so the left column doesn't sit empty.
           Plain links keep the full image reachable without JS. -->
      <div class="case-gallery-reveal">
        <div class="case-gallery-inner">
          <div class="case-gallery">
            {shots.map(({ src, label }, i) => (
              <a href={src} target="_blank" rel="noopener noreferrer" class="case-thumb" data-label={label} style={`--i: ${i}`}>
                <!-- Not lazy: the collapsed wrapper has zero height, so a lazy
                     image would only start loading as the reveal begins and
                     would pop in mid-animation. ~120 kB for all three. -->
                <span class="case-thumb-img">
                  <img src={src} alt={label} decoding="async" />
                  <span class="case-thumb-zoom">點擊放大</span>
                </span>
                <span class="case-thumb-label">{label}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="case-body">
      <div class="case-title">
        <h3>Wama&#39; House 寵物零食電商</h3>
        <span class="case-status">已上線營運中</span>
      </div>
      <p class="case-lead">前端、後端、金流、物流與部署，從零到上線的完整電商系統。</p>

      <!-- Button + grid-row reveal so the height animates; the disclosure
           script toggles .is-open on click and when scrolled into view. -->
      <div class="case-more" data-auto-open>
        <button type="button" class="case-toggle" aria-expanded="false" aria-controls="case-detail">
          <span class="case-toggle-caret"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" /></svg></span>我做了什麼
        </button>

        <div class="case-reveal" id="case-detail">
          <div class="case-reveal-inner">
            <div class="case-points">
              {highlights.map(({ title, body }, i) => (
                <div class="case-point" style={`--i: ${i}`}>
                  <h4>{title}</h4>
                  <p>{body}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <a href="https://umimididi.com" target="_blank" rel="noopener noreferrer" class="case-link">
        查看線上網站 ↗
      </a>
    </div>
  </article>

</section>

<dialog id="shot-lightbox" class="lightbox" aria-label="截圖預覽">
  <button type="button" class="lightbox-close" data-close-lightbox aria-label="關閉"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg></button>
  <img id="lightbox-img" src="" alt="" />
  <span id="lightbox-caption" class="lightbox-caption"></span>
</dialog>
