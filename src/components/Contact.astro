---
const formspreeEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT ?? '';

const items = [
  { icon: '📍', label: '位置', value: '台北, 台灣' },
  {
    icon: '✉️',
    label: 'Email',
    link: { href: 'mailto:b97170098@gmail.com', text: 'b97170098@gmail.com' },
  },
  {
    icon: '💼',
    label: 'LinkedIn',
    link: {
      href: 'https://www.linkedin.com/in/yuzen-chen-a82149167',
      text: 'yuzen-chen',
      external: true,
    },
  },
  {
    icon: '🐙',
    label: 'GitHub',
    link: {
      href: 'https://github.com/yuzenchen',
      text: 'github.com/yuzenchen',
      external: true,
    },
  },
];
---
<section id="contact" class="contact">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">聯絡我</h2>
      <div class="section-line"></div>
      <p class="section-description">準備開始您的專案？讓我們一起討論!</p>
    </div>
    <div class="contact-content">
      <div class="contact-info">
        {items.map((item) => (
          <div class="contact-item">
            <div class="contact-icon">{item.icon}</div>
            <div class="contact-details">
              <h4>{item.label}</h4>
              {item.link ? (
                <p>
                  <a
                    href={item.link.href}
                    class="contact-link"
                    target={item.link.external ? '_blank' : undefined}
                    rel={item.link.external ? 'noopener noreferrer' : undefined}
                  >
                    {item.link.text}
                  </a>
                </p>
              ) : (
                <p>{item.value}</p>
              )}
            </div>
          </div>
        ))}
      </div>
      <div class="contact-form">
        <form id="contact-form" action={formspreeEndpoint} method="POST">
          <div class="form-group">
            <input type="text" id="name" name="name" placeholder=" " required />
            <label for="name">姓名</label>
          </div>
          <div class="form-group">
            <input type="email" id="email" name="email" placeholder=" " required />
            <label for="email">Email</label>
          </div>
          <div class="form-group">
            <select id="service" name="service" required>
              <option value="">選擇服務類型</option>
              <option value="web-development">網站開發</option>
              <option value="sre">系統可靠性工程</option>
              <option value="devops">DevOps自動化</option>
              <option value="consulting">技術諮詢</option>
            </select>
          </div>
          <div class="form-group">
            <textarea id="message" name="message" rows="5" placeholder=" " required></textarea>
            <label for="message">專案詳情</label>
          </div>
          <button type="submit" class="btn btn-primary btn-full">
            <span>發送訊息</span>
            <div class="btn-hover-effect"></div>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
