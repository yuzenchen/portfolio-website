---
const formspreeEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT ?? '';

const services = [
  { value: 'web-development', label: '網站開發' },
  { value: 'consulting', label: '技術諮詢' },
  { value: 'automation', label: '自動化流程' },
  // The field is required, so anyone unsure which of the three fits — or with
  // something else entirely — needs a way through to the message box.
  { value: 'other', label: '其他' },
];

// LINE official account. The message link pre-fills a first line so the owner
// can tell a chat came from the site; the QR (public/line-qr.svg, a static
// asset) encodes the add-friend link for desktop visitors to scan.
const lineMessageUrl = `https://line.me/R/oaMessage/@732byypo/?${encodeURIComponent('我從官網來，想詢問：')}`;
---
<section id="contact">
  <div class="contact-card">
    <span class="contact-stamp">06 / 聯絡</span>
    <h2>公司裡有哪件事，每天都在重複做？</h2>
    <p>告訴我，我免費幫您評估能不能自動化、能省下多少時間。一個工作天內回覆。</p>
    <a href="#contact" class="contact-mail" data-booking>免費諮詢 15&nbsp;分鐘</a>
    <div class="contact-github">
      <a href="mailto:mail@yuzen.tw">mail@yuzen.tw</a>
    </div>
    <div class="contact-line">
      <img class="contact-line-qr" src="/line-qr.svg" width="120" height="120" alt="LINE 加好友 QR code" loading="lazy" decoding="async" />
      <div class="contact-line-body">
        <p class="contact-line-note">或用 LINE 直接留言給我<span class="contact-line-scan">，手機掃描即可加好友</span></p>
        <a class="contact-line-btn" href={lineMessageUrl} target="_blank" rel="noopener">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2.5C4.7 2.5 2 4.6 2 7.3c0 2.4 2.2 4.4 5.1 4.7l-.6 2 3-2c2.6-.4 4.5-2.3 4.5-4.7 0-2.7-2.7-4.8-6-4.8z" /></svg>
          LINE 詢問<span aria-hidden="true">&nbsp;↗</span><span class="sr-only">（在新分頁開啟）</span>
        </a>
      </div>
    </div>
  </div>
</section>

<dialog id="booking-dialog" class="booking" aria-labelledby="booking-title">
  <form id="contact-form" action={formspreeEndpoint} method="POST" class="booking-panel" novalidate>
    <button type="button" class="booking-close" data-close-dialog aria-label="關閉"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg></button>
    <span class="booking-stamp">15 min / free</span>
    <h2 id="booking-title">預約免費技術諮詢</h2>
    <p class="booking-lead">留下聯絡方式與需求，我會安排時間與您聊聊。</p>

    <div class="form-grid">
      <div class="form-group">
        <label for="name">姓名</label>
        <input type="text" id="name" name="name" required />
        <p class="field-error" id="name-error" hidden></p>
      </div>
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required />
        <p class="field-error" id="email-error" hidden></p>
      </div>
      <div class="form-group form-group--full">
        <label for="service">服務類型</label>
        <select id="service" name="service" required>
          <option value="">選擇服務類型</option>
          {services.map(({ value, label }) => <option value={value}>{label}</option>)}
        </select>
      </div>
      <div class="form-group form-group--full">
        <label for="message">需求說明</label>
        <textarea id="message" name="message" rows="4" required></textarea>
        <p class="field-error" id="message-error" hidden></p>
      </div>
    </div>

    <p class="form-status" data-form-status role="alert" hidden></p>

    <div class="booking-actions">
      <button type="submit" class="contact-mail">送出預約</button>
      <button type="button" class="booking-cancel" data-close-dialog>取消</button>
    </div>
  </form>
</dialog>
